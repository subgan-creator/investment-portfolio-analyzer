# Investment Portfolio Analyzer - Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API Key (Required for AI Advisor feature)
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Flask session signing key (Required in production). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset locally, a random key is created and kept in data/.secret_key
SECRET_KEY=replace-with-a-long-random-string

# Where to store profile, snapshots, chat and fund profiles (Optional locally).
# Unset            -> local SQLite file data/portfolio.db
# Render Postgres  -> paste the database's Internal Database URL, e.g.
#   DATABASE_URL=postgresql://user:password@host:5432/portfolio
# Render persistent disk mounted at /var/data ->
#   DATABASE_URL=sqlite:////var/data/portfolio.db
# DATABASE_URL=
